#include "main.h"
#include <stdarg.h>

/**
 * print_unsigned - prints unsigned numbers in different bases
 * @ap: argument list containing the number
 * @spec: conversion specifier ('u', 'o', 'x', 'X')
 * Return: number of characters printed, -1 on error
 */
static int print_unsigned(va_list ap, char spec)
{
	unsigned int n = va_arg(ap, unsigned int);
	char buf[32];
	char *digits;
	int base, i = 0, count = 0;

	if (spec == 'u')
	{
		base = 10;
		digits = "0123456789";
	}
	else if (spec == 'o')
	{
		base = 8;
		digits = "01234567";
	}
	else if (spec == 'x')
	{
		base = 16;
		digits = "0123456789abcdef";
	}
	else /* 'X' */
	{
		base = 16;
		digits = "0123456789ABCDEF";
	}

	if (n == 0)
	{
		if (_putchar('0') == -1)
			return (-1);
		return (1);
	}

	while (n > 0)
	{
		buf[i++] = digits[n % base];
		n /= base;
	}

	while (--i >= 0)
	{
		if (_putchar(buf[i]) == -1)
			return (-1);
		count++;
	}

	return (count);
}
